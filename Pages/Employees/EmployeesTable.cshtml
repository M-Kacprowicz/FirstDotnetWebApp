@page
@model FirstWebApp.Pages.Employees.EmployeesTable
@{
    ViewData["Title"] = "Employees";
}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Surname</th>
        <th>Departament</th>
        <th>Base Salary</th>
        <th>Monthly Bonus</th>
        <th>Created At</th>
    </tr>

    @foreach(var employee in Model.EmployeesList)
    {
        <tr>
            <td>@employee.Id</td>
            <td>@employee.Name</td>
            <td>@employee.Surname</td>
            <td>@employee.Departament</td>
            <td>@(employee.BaseSalary)$</td>
            <td>@(employee.MonthlyBonus)$</td>
            <td>@employee.CreatedAtUtc.ToString("dd/MM/yyyy")</td>
        </tr>
    }
</table>